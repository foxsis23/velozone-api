# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=velozone-api

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
APP_URL=http://localhost:3000

# JWT
JWT_SECRET=change-this-secret-in-production

# Email (Ethereal for dev: https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Auth App <noreply@authapp.dev>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
OAUTH_REDIRECT_URL=http://localhost:3000/oauth/callback

# Logging
LOG_LEVEL=info
